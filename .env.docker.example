# Скопируйте в .env рядом с docker-compose.yml и подставьте значения.

# Обязательно при GIN_MODE=release (так задано в образе бэкенда)
JWT_SECRET=измените_на_длинную_случайную_строку

# Порт на хосте (по умолчанию 80)
HTTP_PORT=80

# URL API для сборки фронта: относительный путь ок, если всё идёт через контейнер web
VITE_API_URL=/api

# Яндекс.Карты (карта при выборе адреса): https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=

# Первый админ (см. horovats-backend/database)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Если открываете API на другом origin (не через nginx web):
# CORS_ORIGINS=https://example.com
