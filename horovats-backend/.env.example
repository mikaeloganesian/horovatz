# Локальная разработка (опционально; godotenv подхватит этот файл)
JWT_SECRET=

# ЮKassa — https://yookassa.ru/my/merchant/integration/api-keys
# Без этих переменных заказ создаётся без онлайн-оплаты (статус new).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/payment/return
# Чек 54-ФЗ: 3 = УСН «доходы минус расходы», 1 = без НДС
YOOKASSA_TAX_SYSTEM_CODE=3
YOOKASSA_VAT_CODE=1
