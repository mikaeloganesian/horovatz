# SMS уведомления админу о новом заказе (SMSC.ru — https://smsc.ru/api/http/send/)
# Запрос идёт на https://smsc.ru/sys/send.php
#
# Авторизация (один способ):
# - Если задан SMSC_API_KEY — используется только он (логин/пароль из .env для SMSC не читаются).
# - Иначе нужны SMSC_LOGIN и SMSC_PASSWORD (пароль для API: https://smsc.ru/passwords/).
SMSC_LOGIN=
SMSC_PASSWORD=

SMSC_API_KEY=

# Получатель(и) через запятую; если не задано — в коде по умолчанию 89687775550
SMSC_PHONES=89687775550
